# Set the default behavior for all text files to use LF line endings
* text=auto eol=lf

# Shell scripts must have LF line endings
*.sh eol=lf
*.bash eol=lf
Makefile eol=lf

# Binary file types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary

# Vendor binaries -> LFS
packages/core/vendor/ripgrep/** filter=lfs diff=lfs merge=lfs -text
packages/core/vendor/tree-sitter/*.wasm filter=lfs diff=lfs merge=lfs -text

# Electron resources -> LFS
packages/desktop/apps/electron/resources/dmg-background.tiff filter=lfs diff=lfs merge=lfs -text
apps/electron/resources/backgrounds/*.jpg filter=lfs diff=lfs merge=lfs -text
apps/electron/resources/session-mcp-server/index.js filter=lfs diff=lfs merge=lfs -text

# Extension zips -> LFS
packages/mcp-chrome-integration/extension/chrome-extension/latest/*.zip filter=lfs diff=lfs merge=lfs -text

# Docs images -> LFS
docs/design/*.jpg filter=lfs diff=lfs merge=lfs -text
docs/assets/*.png filter=lfs diff=lfs merge=lfs -text

# Vendor tarballs -> LFS
zvec-0.0.1.tgz filter=lfs diff=lfs merge=lfs -text
